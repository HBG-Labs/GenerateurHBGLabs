{
  "schema": "creative-style-profile",
  "schema_version": "0.1.0",
  "id": "p14_signal",
  "version": "1.0.0",
  "name": "P1.4 Signal variable",
  "origin": "authored",
  "role_contract": "0.1.0",
  "reference_canvas": { "width": 1080, "height": 1920 },
  "palette": {
    "surface.primary": "#FFE14D",
    "surface.inverse": "#111111",
    "text.primary": "#111111",
    "text.inverse": "#FFE14D",
    "accent": "#B51535"
  },
  "typography": {
    "families": {
      "variable_mono": {
        "css_name": "p14-signal-variable",
        "files": [
          {
            "weight": 500,
            "style": "normal",
            "src": "lib:noto_sans_mono/noto-sans-mono-wdth-wght.ttf",
            "sha256": "2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081",
            "axes": { "wght": 500, "wdth": 82 }
          },
          {
            "weight": 700,
            "style": "normal",
            "src": "lib:noto_sans_mono/noto-sans-mono-wdth-wght.ttf",
            "sha256": "2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081",
            "axes": { "wght": 700, "wdth": 82 }
          }
        ]
      }
    },
    "scale": {
      "display.xl": { "family": "variable_mono", "weight": 700, "size": 116, "line_height": 1.04, "tracking_em": -0.035, "case": "upper", "min_size": 58 },
      "display.l": { "family": "variable_mono", "weight": 700, "size": 96, "line_height": 1.06, "tracking_em": -0.03, "case": "upper", "min_size": 50 },
      "display.m": { "family": "variable_mono", "weight": 700, "size": 78, "line_height": 1.08, "tracking_em": -0.02, "case": "upper", "min_size": 44 },
      "headline": { "family": "variable_mono", "weight": 700, "size": 58, "line_height": 1.12, "tracking_em": -0.01, "case": "as_is", "min_size": 36 },
      "body": { "family": "variable_mono", "weight": 500, "size": 38, "line_height": 1.28, "tracking_em": 0, "case": "as_is", "min_size": 30 },
      "subtitle": { "family": "variable_mono", "weight": 500, "size": 40, "line_height": 1.24, "tracking_em": 0, "case": "as_is", "min_size": 30 }
    }
  },
  "grid": { "columns": 6, "rows": 12, "margin": { "top": 120, "right": 64, "bottom": 160, "left": 64 }, "gutter": 16 },
  "space": { "xs": 6, "sm": 12, "md": 24, "lg": 48, "xl": 72 },
  "strokes": { "hairline": 2, "emphasis": 12 },
  "motifs": { "rule": { "kind": "line", "length_cols": 6, "weight": "emphasis", "cap": "square" } },
  "composition_personality": {
    "preferred_systems": [{ "id": "image_hero", "weight": 1 }],
    "negative_space": "dense",
    "alignment": "start",
    "asymmetry": 0.78
  },
  "motion_personality": {
    "easings": {
      "enter": { "type": "bezier", "p": [0.05, 0.9, 0.1, 1] },
      "exit": { "type": "linear" },
      "inout": { "type": "bezier", "p": [0.8, 0, 0.2, 1] },
      "settle": { "type": "spring", "damping": 40, "stiffness": 400, "mass": 0.6, "initial_velocity": 0 }
    },
    "max_overshoot": 0.015,
    "behaviors": {
      "REVEAL_TEXT": { "allowed": true, "variants": ["mask_up"] },
      "ACCENT_WORD": { "allowed": true, "variants": ["color_settle"] },
      "SETTLE": { "allowed": true },
      "EXIT_CLEAR": { "allowed": true },
      "CUT": { "allowed": true },
      "DRAW_PATH": { "allowed": true },
      "MATCH_LINE": { "allowed": true },
      "CAMERA_PUSH": { "allowed": true, "param_bounds": { "scale": { "min": 1, "max": 1.08 } } },
      "FOCUS_REGION": { "allowed": true, "param_bounds": { "scale": { "min": 1, "max": 1.12 } } },
      "HIGHLIGHT_REGION": { "allowed": true, "variants": ["outline", "accent"] },
      "MASK_WIPE": { "allowed": true }
    }
  },
  "rhythm_personality": {
    "tempo": {
      "beat_ms": { "CALM": 420, "BUILD": 360, "ACCELERATE": 260, "INTERRUPTION": 300, "REVEAL": 380, "RESOLUTION": 520 },
      "breath_ms": 260
    },
    "reading": { "ms_per_word": 240, "min_hold_ms": 700 },
    "preferred_curves": [{ "id": "hard_cuts", "weight": 1 }]
  },
  "subtitle_style": {
    "type": "type.subtitle",
    "color": "color.text.inverse",
    "backdrop": "color.surface.inverse",
    "max_chars_per_line": 24,
    "max_lines": 2,
    "active_word": "underline"
  },
  "sound_personality": {
    "event_cues": {},
    "cues": {},
    "max_cues_per_video": 0
  },
  "voice_personality": { "description": "Direction neutre ; aucune voix n’est produite en P1.4." },
  "image_treatment": {
    "grade": "duotone",
    "contrast": 0.5,
    "grain": 0.05,
    "duotone": { "dark": "color.surface.inverse", "light": "color.surface.primary" }
  },
  "illustration_treatment": { "stroke": "bold", "fill": "none", "palette_roles": ["color.text.primary", "color.accent"] },
  "transition_preferences": { "preferred": ["MASK_WIPE", "CUT"], "avoid": [] },
  "forbidden": { "behaviors": [], "style_tags": ["system_fallback"] }
}
